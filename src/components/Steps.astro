---
// How it works: the four steps side by side, all visible at once. Each card is a still of that moment
// (the TV waiting, the phone scanning its code, the files uploading, the menu live), so the whole setup reads
// in one glance with no waiting. A line joins the numbers, left to right in reading order.
import { Image } from 'astro:assets';
import QRCode from 'qrcode';
import type { Content } from '../i18n';
import Logo from './Logo.astro';
import Signal from './Signal.astro';
import shakshuka from '../assets/media/shakshuka.jpg';
import burger from '../assets/media/burger-meal.jpg';
import cake from '../assets/media/coffee-cake.jpg';

interface Props { c: Content }
const { c } = Astro.props;
const s = c.steps;
const qr = await QRCode.toString(`lawha://pair?code=${s.pairing.code}`, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#0a0d14ff', light: '#00000000' } });
const pic = c.playlists[0]?.offer;
const ar = c.lang === 'ar';
const t = ar
  ? { boot: 'جاهز للربط', files: ['الفطور', 'الغداء', 'الحلا'], live: 'يُعرض الآن' }
  : { boot: 'Ready to pair', files: ['Breakfast', 'Lunch', 'Sweets'], live: 'Live now' };
const thumbs = [shakshuka, burger, cake];
const check = '<svg viewBox="0 0 16 16" width="100%" height="100%" aria-hidden="true"><path d="M3.5 8.4l2.9 2.9 6.1-6.6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<section class="steps wrap" id="how" aria-labelledby="how-h">
  <header class="sec-head" data-reveal>
    <h2 class="sec-title" id="how-h">{s.heading}</h2>
  </header>

  <ol class="row">
    {s.items.map((it, i) => (
      <li class="card" data-reveal style={`--i:${i}`}>
        <div class:list={['pic', `pic-${i + 1}`]} aria-hidden="true">
          {i === 0 && (
            <div class="rig">
              <div class="tv"><div class="scr boot"><Logo size={26} /><span class="b-sub"><span class="dot"></span>{t.boot}</span></div></div>
              <div class="box"><span class="led"></span></div>
            </div>
          )}
          {i === 1 && (
            <div class="phone"><div class="ph"><div class="scan">
              <span class="vf"><span class="qr" set:html={qr} /><span class="vf-line"></span></span>
              <span class="code nums" dir="ltr">{s.pairing.code.slice(0, 3)} {s.pairing.code.slice(3)}</span>
            </div></div></div>
          )}
          {i === 2 && (
            <div class="phone"><div class="ph"><div class="up">
              {t.files.map((name, k) => (
                <span class="f" style={`--k:${k}`}>
                  <Image src={thumbs[k]!} alt="" widths={[96]} sizes="2.5rem" class="f-img" loading="lazy" />
                  <span class="f-n">{name}</span>
                  <span class="ok" set:html={check} />
                </span>
              ))}
            </div></div></div>
          )}
          {i === 3 && (
            <div class="rig">
              <div class="tv"><div class="scr menu">
                <Image src={shakshuka} alt="" widths={[400, 640]} sizes="(max-width: 40rem) 80vw, 22vw" class="m-img" loading="lazy" />
                <span class="m-cap"><b>{pic?.title}</b><span class="m-chip nums">{pic?.price} <small>{c.currency}</small></span></span>
                <span class="m-live"><Signal size={10} />{t.live}</span>
              </div></div>
              <div class="box"><span class="led"></span></div>
            </div>
          )}
        </div>
        <h3 class="line"><span class="num nums">{i + 1}</span>{it.line}</h3>
      </li>
    ))}
  </ol>
</section>

<style>
  .steps { padding-block: clamp(1rem, 3vw, 2.5rem) var(--section); }
  .row { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(0.75rem, 1.4vw, 1.25rem); }
  .card { display: flex; flex-direction: column; gap: 1rem; }

  /* the picture: one still per step on the page's grey */
  .pic { container-type: size; display: flex; align-items: center; justify-content: center; aspect-ratio: 4 / 3.4; padding: 7%; border-radius: calc(var(--radius) * 1.5); background: var(--surface); overflow: hidden; transition: translate var(--t-ui) var(--ease-out); }
  .pic-4 { background: var(--accent-soft); }
  @media (hover: hover) and (pointer: fine) { .card:hover .pic { translate: 0 -4px; } }

  .line { display: flex; align-items: center; gap: 0.7rem; font-size: clamp(1.125rem, 1rem + 0.45vw, 1.375rem); line-height: var(--lh-head); font-weight: 700; }
  .num { flex: none; display: grid; place-items: center; inline-size: 2rem; block-size: 2rem; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-size: 0.9375rem; line-height: 1; }

  /* TV + player box */
  .rig { inline-size: 84cqi; display: flex; flex-direction: column; align-items: center; gap: 2.5cqi; }
  .tv { inline-size: 100%; aspect-ratio: 16 / 9; padding: 1.6cqi; border-radius: 2.6cqi; background: var(--tv); }
  .scr { position: relative; block-size: 100%; border-radius: 1.4cqi; overflow: hidden; background: var(--tv-screen); color: var(--tv-ink); }
  .box { position: relative; inline-size: 24cqi; block-size: 6cqi; border-radius: 1.8cqi; background: var(--ink); }
  .led { position: absolute; inset-block-start: 50%; inset-inline-end: 2.4cqi; inline-size: 1.6cqi; block-size: 1.6cqi; margin-block-start: -0.8cqi; border-radius: 50%; background: var(--live); }
  .boot { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3cqi; }
  .b-sub { display: inline-flex; align-items: center; gap: 0.45em; font-size: max(0.6875rem, 5cqi); color: var(--tv-muted); }
  .dot { inline-size: 0.5em; block-size: 0.5em; border-radius: 50%; background: var(--live); }
  @media (prefers-reduced-motion: no-preference) { .dot { animation: blink 1.6s ease-in-out infinite; } }
  @keyframes blink { 50% { opacity: 0.25; } }

  .menu .m-img { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; }
  .m-cap { position: absolute; inset-inline: 4cqi; inset-block-end: 4cqi; display: flex; align-items: center; justify-content: space-between; gap: 2cqi; font-size: max(0.6875rem, 5cqi); text-shadow: 0 1px 6px rgb(0 0 0 / 0.6); }
  .m-chip { padding: 0.15em 0.6em; border-radius: var(--pill); background: var(--accent); color: #fff; font-weight: 700; text-shadow: none; }
  .m-live { position: absolute; inset-block-start: 4cqi; inset-inline-start: 4cqi; display: inline-flex; align-items: center; gap: 0.4em; padding: 0.2em 0.6em; border-radius: var(--pill); background: rgb(10 13 20 / 0.7); font-size: max(0.625rem, 4cqi); font-weight: 500; }
  .m-live :global(.signal) { color: var(--live); }

  /* the owner's phone */
  .phone { block-size: 88cqb; aspect-ratio: 9 / 16; padding: 1.6cqi; border-radius: 6cqi; background: var(--ink); }
  .ph { block-size: 100%; border-radius: 4.6cqi; overflow: hidden; background: #fff; color: var(--ink); container-type: inline-size; }
  .scan { block-size: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8cqi; padding: 10cqi; }
  .vf { position: relative; inline-size: 78cqi; aspect-ratio: 1; padding: 10cqi; border-radius: 8cqi; background: var(--surface); }
  .qr { display: block; inline-size: 100%; block-size: 100%; }
  .qr :global(svg) { display: block; inline-size: 100%; block-size: 100%; }
  .vf-line { position: absolute; inset-inline: 6cqi; inset-block-start: 50%; block-size: 2px; border-radius: 2px; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
  @media (prefers-reduced-motion: no-preference) { .vf-line { animation: scan 2.2s ease-in-out infinite alternate; } }
  @keyframes scan { from { inset-block-start: 14%; } to { inset-block-start: 86%; } }
  .code { font-weight: 700; font-size: 12cqi; letter-spacing: 0.06em; }

  .up { block-size: 100%; display: flex; flex-direction: column; justify-content: center; gap: 5cqi; padding: 8cqi; }
  .f { display: flex; align-items: center; gap: 5cqi; padding: 4cqi; border-radius: 6cqi; background: var(--surface); }
  .f-img { flex: none; inline-size: 22cqi; block-size: 22cqi; border-radius: 4cqi; object-fit: cover; }
  .f-n { flex: 1; min-inline-size: 0; font-size: max(0.625rem, 9cqi); font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ok { flex: none; display: grid; place-items: center; inline-size: 14cqi; block-size: 14cqi; padding: 2.5cqi; border-radius: 50%; background: var(--live); color: #fff; }

  @media (max-width: 64rem) { .row { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2rem; } }
  @media (max-width: 30rem) {
    .row { grid-template-columns: minmax(0, 1fr); }
    .pic { aspect-ratio: 16 / 10; }
  }
</style>
