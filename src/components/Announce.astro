---
// Announcements: the headline is an input. What the visitor types appears on the TV over the menu.
import type { Content } from '../i18n';
interface Props { c: Content }
const { c } = Astro.props;
const a = c.announce;
const menu = c.playlists[0]?.list;
const minutes = [15, 30, 60];
---
<section class="announce wrap" id="announce" aria-labelledby="ann-h" data-announce>
  <header class="sec-head" data-reveal>
    <h2 class="sec-title" id="ann-h">{a.heading}</h2>
    <p class="sec-sub">{a.inputLabel}</p>
  </header>
  <div class="type-line" data-ui data-reveal>
    <label class="sr-only" for="ann-input">{a.inputLabel}</label>
    <input id="ann-input" class="ann-input" type="text" value={a.initial} maxlength="44" autocomplete="off" spellcheck="false" enterkeyhint="done" />
    <span class="mirror" aria-hidden="true"></span>
    <span class="caret" aria-hidden="true"></span>
  </div>

  <div class="answer">
    <div class="ann-tv" data-ui data-reveal style="--i:1" aria-hidden="true">
      <div class="scr">
        <div class="menu">
          <span class="m-t">{menu?.title}</span>
          {menu?.items.slice(0, 1).map((i) => <span class="m-r"><span>{i.name}</span><span class="nums">{i.price} <small>{c.currency}</small></span></span>)}
        </div>
        <div class="banner">
          <span class="b-tag">{a.tag}</span>
          <span class="b-text" data-ann-out>{a.initial}</span>
          <span class="b-time">{a.ends} <span class="nums" data-ann-time dir="ltr">30:00</span></span>
        </div>
      </div>
    </div>

    <div class="side" data-reveal style="--i:2">
      <p class="statement">{a.statement}</p>
      <fieldset class="dur">
        <legend class="sr-only">{a.durationLabel}</legend>
        {a.durations.map((d, i) => (
          <label class="d-btn"><input class="ghost-input" type="radio" name="ann-duration" value={minutes[i]} checked={i === 1} />{d}</label>
        ))}
      </fieldset>
    </div>
  </div>

  <div class="examples" data-reveal style="--i:3">
    <span class="ex-l">{a.exampleLabel}</span>
    {a.examples.map((e) => <button type="button" class="ex link" data-example={e}>{e}</button>)}
  </div>
</section>

<style>
  .announce { display: flex; flex-direction: column; gap: clamp(1.5rem, 3vw, 2.5rem); padding-block: 0 var(--section); }
  .announce .sec-head { margin-block-end: 0; }
  /* the editable line reads as a field: a filled box with its own caret */
  .type-line { position: relative; overflow: clip; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.75rem, 1rem + 2.4vw, 3.25rem); line-height: var(--lh-display); padding: 0.35em 0.5em; border-radius: var(--radius); background: #ffffff; outline: 2px solid var(--surface); outline-offset: -2px; transition: outline-color var(--t-ui) ease; }
  .type-line:focus-within { outline-color: var(--accent); }
  :root[lang="en"] .type-line { letter-spacing: -0.025em; }
  .ann-input { width: 100%; border: 0; background: transparent; padding: 0.06em 0; font: inherit; letter-spacing: inherit; color: var(--ink); caret-color: var(--accent); outline: none; text-overflow: clip; }
    .mirror { position: absolute; visibility: hidden; white-space: pre; font: inherit; letter-spacing: inherit; top: 0; inset-inline-start: 0.5em; }
  .caret { position: absolute; top: 24%; height: 52%; width: 0.07em; background: var(--accent); inset-inline-start: calc(0.5em + var(--caret, 0px)); }
  .type-line:focus-within .caret, .type-line.is-long .caret { display: none; }
  @media (prefers-reduced-motion: no-preference) { .caret { animation: caret 1.05s steps(1) infinite; } }
  @keyframes caret { 50% { opacity: 0; } }

  .answer { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: end; }
  .ann-tv { grid-column: 1 / span 6; width: 100%; max-width: 40rem; aspect-ratio: 16 / 9; background: var(--tv); padding: 7px; border-radius: 12px; }
  .scr { position: relative; height: 100%; border-radius: 6px; overflow: hidden; background: var(--tv-screen); color: var(--tv-ink); container-type: size; display: flex; flex-direction: column; gap: 4cqh; padding: 8cqh 5cqw; }
  /* the menu keeps whatever room the banner leaves, so the banner never sits on top of it */
  .menu { flex: 1 1 0; min-block-size: 0; overflow: hidden; padding-inline: 2cqw; display: flex; flex-direction: column; gap: 3.2cqh; opacity: 0.4; }
  .m-t { font-family: var(--font-display); font-weight: 700; color: var(--signal); font-size: 11cqh; line-height: 1.2; }
  .m-r { display: flex; justify-content: space-between; font-size: 7.5cqh; }
  .m-r small { color: var(--tv-muted); }
  .banner { flex: none; padding: 5cqh 5cqw; border-radius: 10px; background: var(--accent); color: var(--accent-ink); display: flex; flex-direction: column; gap: 2cqh; }
  .b-tag { align-self: flex-start; font-size: max(0.6875rem, 5.4cqh); font-weight: 700; background: var(--accent-ink); color: var(--accent); padding: 0.15em 0.6em; border-radius: 999px; }
  .b-text { font-family: var(--font-display); font-weight: 700; font-size: max(1rem, 11cqh); line-height: 1.25; overflow-wrap: anywhere; min-height: 1.25em; }
  .b-time { font-size: max(0.6875rem, 5.4cqh); font-weight: 500; }
  @media (prefers-reduced-motion: no-preference) { .banner.is-bump { animation: bump 380ms var(--ease-out); } }
  @keyframes bump { from { transform: translateY(6px); opacity: 0.6; } }

  .side { grid-column: 8 / -1; display: flex; flex-direction: column; gap: 1.5rem; }
  .statement { font-size: var(--step-lead); line-height: 1.6; max-width: 30ch; }
  :root[lang="en"] .statement { line-height: 1.4; }
  .dur { display: inline-flex; gap: 0.5rem; flex-wrap: wrap; margin: 0; padding: 0; border: 0; min-inline-size: 0; }
  .d-btn { position: relative; display: inline-flex; align-items: center; cursor: pointer; min-block-size: 2.75rem; padding: 0 1.1rem; border-radius: 999px; background: var(--surface); font-weight: 500; font-size: var(--step-small); transition: background-color var(--t-ui) ease, color var(--t-ui) ease, scale var(--t-press) var(--ease-out); }
  .d-btn:active { scale: 0.96; }
  .d-btn:has(:checked) { background: var(--ink); color: var(--bg); }
  @media (hover: hover) and (pointer: fine) { .d-btn:not(:has(:checked)):hover { background: #e2e6ec; } }

  .examples { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1.75rem; font-size: var(--step-body); }
  .ex-l { color: var(--muted); }
  .ex { text-decoration-color: rgb(10 13 20 / 0.35); text-align: start; padding-block: 0.4rem; }

  @media (max-width: 54rem) {
    .announce { min-height: 0; }
    .type-line { font-size: clamp(1.25rem, 0.6rem + 3.4vw, 1.75rem); }
    .answer { display: flex; flex-direction: column; align-items: stretch; gap: 1.75rem; }
    .examples { gap: 0.5rem; }
    .ex-l { width: 100%; }
    .ex { min-height: 2.75rem; padding: 0.5rem 1rem; border-radius: var(--radius); background: var(--surface); text-decoration: none; font-size: var(--step-small); }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-announce]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('.ann-input')!;
    const mirror = root.querySelector<HTMLElement>('.mirror')!;
    const line = root.querySelector<HTMLElement>('.type-line')!;
    const out = root.querySelector<HTMLElement>('[data-ann-out]')!;
    const banner = root.querySelector<HTMLElement>('.banner')!;
    const time = root.querySelector<HTMLElement>('[data-ann-time]')!;
    const durs = [...root.querySelectorAll<HTMLInputElement>('input[name="ann-duration"]')];
    let seconds = 30 * 60;

    const placeCaret = () => {
      mirror.textContent = input.value;
      const w = mirror.offsetWidth;
      line.style.setProperty('--caret', `${w + 6}px`);
      line.classList.toggle('is-long', w + 12 > line.clientWidth);
    };
    const render = () => {
      out.textContent = input.value.trim() || input.placeholder;
      placeCaret();
    };
    const bump = () => { banner.classList.remove('is-bump'); void banner.offsetWidth; banner.classList.add('is-bump'); };

    input.addEventListener('input', render);
    root.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((b) => b.addEventListener('click', () => {
      input.value = b.dataset['example'] ?? '';
      render();
      bump();
    }));

    const fmt = (s: number) => `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
    durs.forEach((input) => input.addEventListener('change', () => {
      if (!input.checked) return;
      seconds = Number(input.value) * 60;
      time.textContent = fmt(seconds);
      bump();
    }));

    let visible = false;
    new IntersectionObserver(([e]) => { visible = !!e?.isIntersecting; }).observe(root);
    window.setInterval(() => {
      if (!visible || document.hidden) return;
      seconds = seconds > 0 ? seconds - 1 : 0;
      time.textContent = fmt(seconds);
    }, 1000);

    document.fonts?.ready.then(placeCaret);
    window.addEventListener('resize', placeCaret);
    render();
  }
</script>
