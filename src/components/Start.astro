---
// «ابدأ مع لوحة»: the form every «start» button leads to. The visitor leaves their details and the team calls them.
// Requests are emailed to LEADS_EMAIL through FormSubmit (formsubmit.co), because GitHub Pages has no server:
// - with script, the form posts JSON to the ajax endpoint and swaps itself for a thank-you panel;
// - without script, it posts normally and FormSubmit sends the visitor back here with ?sent=1.
// The email always uses the Arabic labels, so the team reads every request the same way.
// FormSubmit emails the inbox once to activate it; until that link is clicked, requests are not delivered.
import { content, LEADS_EMAIL, startHref, url, type Content } from '../i18n';
import Signal from './Signal.astro';
interface Props { c: Content }
const { c } = Astro.props;
const s = c.start;
const f = s.fields;
const ar = content.ar.start.fields;
const back = new URL(startHref(c) + '?sent=1', Astro.site ?? 'https://lawha.tech').toString();
const labels = {
  name: ar.name.label, phone: ar.phone.label, business: ar.business.label, kind: ar.kind.label, screens: 'عدد الشاشات',
  city: ar.city.label, email: ar.email.label, notes: 'ملاحظات', lang: 'لغة الصفحة',
  options: Object.fromEntries([...ar.kind.options, ...ar.screens.options].map((o) => [o.value, o.label])),
};
const phone = c.footer.phone;
const tel = `tel:${phone.replaceAll(' ', '')}`;
---
<main class="start wrap grid" id="top">
  <section class="intro" aria-labelledby="start-h">
    <h1 class="head" id="start-h" data-rise style="--i:0">{s.heading}</h1>
    <p class="lead muted" data-rise style="--i:1">{s.lead}</p>
    <div class="next" data-rise style="--i:2">
      <h2 class="next-h">{s.nextTitle}</h2>
      <ol class="steps">
        {s.next.map((x, i) => (
          <li><span class="num nums" aria-hidden="true">{i + 1}</span><span><b>{x.title}</b><span class="muted">{x.text}</span></span></li>
        ))}
      </ol>
      <p class="assure small muted">{s.assure}</p>
    </div>
  </section>

  <section class="card" aria-labelledby="form-h" data-rise style="--i:1">
    <form class="form" action={`https://formsubmit.co/${LEADS_EMAIL}`} method="POST" novalidate data-form
      data-endpoint={`https://formsubmit.co/ajax/${LEADS_EMAIL}`} data-labels={JSON.stringify(labels)}
      data-subject={content.ar.start.mailSubject} data-fix={s.fixErrors} data-sending={s.sending}>
      <h2 class="form-h" id="form-h">{s.formTitle}</h2>
      <input type="hidden" name="_subject" value={content.ar.start.mailSubject} />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_next" value={back} />
      <input type="hidden" name="lang" value={c.lang} />
      <label class="hp" aria-hidden="true">Leave empty <input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label>

      <div class="field">
        <label for="f-name">{f.name.label}</label>
        <input class="input" id="f-name" name="name" type="text" required autocomplete="name" maxlength="80" aria-describedby="f-name-err" />
        <p class="err" id="f-name-err" hidden>{f.name.error}</p>
      </div>

      <div class="field">
        <label for="f-phone">{f.phone.label}</label>
        <input class="input" id="f-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" dir="ltr" maxlength="20"
          placeholder="05xxxxxxxx" aria-describedby="f-phone-err" data-phone />
        <p class="err" id="f-phone-err" hidden>{f.phone.error}</p>
      </div>

      <div class="field">
        <label for="f-business">{f.business.label}</label>
        <input class="input" id="f-business" name="business" type="text" required autocomplete="organization" maxlength="100" aria-describedby="f-business-err" />
        <p class="err" id="f-business-err" hidden>{f.business.error}</p>
      </div>

      <fieldset class="field" aria-describedby="f-kind-err">
        <legend>{f.kind.label}</legend>
        <div class="chips">
          {f.kind.options.map((o) => <label class="chip"><input class="ghost-input" type="radio" name="kind" value={o.value} required />{o.label}</label>)}
        </div>
        <p class="err" id="f-kind-err" hidden>{f.kind.error}</p>
      </fieldset>

      <fieldset class="field" aria-describedby="f-screens-err">
        <legend>{f.screens.label}</legend>
        <div class="chips">
          {f.screens.options.map((o) => <label class="chip"><input class="ghost-input" type="radio" name="screens" value={o.value} required />{o.label}</label>)}
        </div>
        <p class="err" id="f-screens-err" hidden>{f.screens.error}</p>
      </fieldset>

      <div class="pair">
        <div class="field">
          <label for="f-city">{f.city.label} <span class="opt">{s.optional}</span></label>
          <input class="input" id="f-city" name="city" type="text" autocomplete="address-level2" maxlength="60" />
        </div>
        <div class="field">
          <label for="f-email">{f.email.label} <span class="opt">{s.optional}</span></label>
          <input class="input" id="f-email" name="email" type="email" autocomplete="email" dir="ltr" maxlength="120" aria-describedby="f-email-err" />
          <p class="err" id="f-email-err" hidden>{f.email.error}</p>
        </div>
      </div>

      <div class="field">
        <label for="f-notes">{f.notes.label} <span class="opt">{s.optional}</span></label>
        <textarea class="input" id="f-notes" name="notes" rows="3" maxlength="1000"></textarea>
      </div>

      <div class="send">
        <button class="button submit" type="submit" data-submit><span data-label>{s.submit}</span> <span class="arrow" aria-hidden="true">→</span><Signal size={16} state="send" class="sending" /></button>
        <p class="small muted">{s.privacy}</p>
      </div>
      <p class="status" role="alert" data-status></p>
      <p class="fail" data-fail hidden>{s.failText} <a class="link" href={tel} dir="ltr">{phone}</a></p>
    </form>

    <div class="done" data-done hidden tabindex="-1">
      <span class="tick" aria-hidden="true"><Signal size={26} /></span>
      <h2 class="form-h">{s.doneTitle}</h2>
      <p class="muted">{s.doneText} <bdi class="nums" dir="ltr" data-done-phone></bdi></p>
      <a class="button" href={url(c.lang === 'ar' ? '/' : '/en/')}>{s.doneBack} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</main>

<style>
  .start { --error: #c4291c; --field: #d5dae3; padding-block: clamp(2rem, 5vw, 4.5rem) var(--section); row-gap: 3rem; align-items: start; }
  .intro { grid-column: 1 / span 5; position: sticky; inset-block-start: 7rem; }
  .card { grid-column: 7 / -1; background: #fff; border-radius: calc(var(--radius) * 1.5); padding: clamp(1.5rem, 3.2vw, 2.75rem); }
  @media (max-width: 54rem) {
    .intro, .card { grid-column: 1 / -1; }
    .intro { position: static; }
  }

  .intro .head { margin-block-end: 1rem; }
  .next { margin-block-start: clamp(2rem, 4vw, 3rem); padding-block-start: clamp(1.5rem, 3vw, 2rem); border-block-start: 1px solid var(--field); }
  .next-h { font-size: var(--step-body); font-weight: 700; margin-block-end: 1.25rem; }
  .steps { display: grid; gap: 1.25rem; }
  .steps li { display: flex; gap: 1rem; align-items: start; }
  .steps li > span:last-child { display: grid; gap: 0.15rem; }
  .num { flex: none; display: grid; place-items: center; inline-size: 2.25rem; block-size: 2.25rem; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-weight: 700; }
  .assure { margin-block-start: 1.75rem; }

  .form { display: grid; gap: 1.5rem; }
  .form[hidden], .done[hidden] { display: none; }
  .form :is(input, textarea) { scroll-margin-block: 7rem 2rem; }
  .form-h { font-size: var(--step-lead); line-height: 1.3; }
  .field { display: grid; gap: 0.5rem; min-inline-size: 0; margin: 0; padding: 0; border: 0; }
  .field > label, .field > legend { font-weight: 500; padding: 0; }
  .field > legend { margin-block-end: 0.5rem; }
  .opt { color: var(--muted); font-weight: 400; font-size: var(--step-small); }
  .input {
    inline-size: 100%; min-block-size: 3.25rem; padding: 0.7rem 1rem; background: var(--bg); color: var(--ink);
    border: 1.5px solid var(--field); border-radius: var(--radius); transition: border-color var(--t-hover) ease, background-color var(--t-hover) ease;
  }
  textarea.input { resize: vertical; min-block-size: 6rem; line-height: 1.6; }
  .input::placeholder { color: #8b93a3; }
  :root[dir="rtl"] .input[dir="ltr"] { text-align: right; }
  .input:focus-visible { outline: 3px solid var(--accent-soft); outline-offset: 0; border-color: var(--accent); background: #fff; }
  .input[aria-invalid="true"] { border-color: var(--error); }
  .err { color: var(--error); font-size: var(--step-small); line-height: 1.5; }

  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    position: relative; display: inline-flex; align-items: center; min-block-size: 2.75rem; padding-inline: 1.1rem;
    border: 1.5px solid var(--field); border-radius: var(--pill); background: var(--bg); cursor: pointer; user-select: none;
    transition: background-color var(--t-hover) ease, border-color var(--t-hover) ease, color var(--t-hover) ease;
  }
  .chip:has(:checked) { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  fieldset[data-invalid] .chip:not(:has(:checked)) { border-color: var(--error); }
  @media (hover: hover) and (pointer: fine) {
    .chip:hover:not(:has(:checked)) { border-color: var(--ink); }
    .input:hover:not(:focus-visible) { border-color: #aeb5c2; }
  }

  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  @media (max-width: 36rem) { .pair { grid-template-columns: 1fr; } }

  .send { display: flex; align-items: center; gap: 1rem 1.5rem; flex-wrap: wrap; padding-block-start: 0.5rem; }
  .submit { min-block-size: 3.5rem; padding-inline: 2rem; }
  /* sending your request is the same signal as publishing a menu: the arrow becomes the arcs going out */
  .submit[aria-busy="true"] { cursor: progress; }
  .submit[aria-busy="true"] .arrow, .submit:not([aria-busy="true"]) :global(.sending) { display: none; }
  @media (max-width: 36rem) { .submit { inline-size: 100%; } }
  .status:empty { display: none; }
  .status { color: var(--error); font-weight: 500; }
  .fail { padding: 1rem 1.25rem; border-radius: var(--radius); background: #fdecea; color: #7a1a12; }

  .hp { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .done { display: grid; justify-items: start; gap: 1rem; padding-block: 1rem; }
  .done:focus { outline: none; }
  /* received: the logo tile, its arcs lighting from the inside out as the panel appears */
  .tick { display: grid; place-items: center; inline-size: 3.75rem; block-size: 3.75rem; border-radius: 1.1rem; background: var(--accent); color: var(--accent-ink); }
  .tick :global(.signal) { display: block; }
  @media (prefers-reduced-motion: no-preference) {
    .done:not([hidden]) .tick :global(.a) { animation: sig-rx 480ms var(--ease-out) both; animation-delay: 200ms; }
    .done:not([hidden]) .tick :global(.a2) { animation-delay: 340ms; }
    .done:not([hidden]) .tick :global(.a3) { animation-delay: 480ms; }
  }
  .done .button { margin-block-start: 0.5rem; }

  @media (forced-colors: active) {
    .chip:has(:checked) { outline: 3px solid Highlight; }
    .card { border: 1px solid CanvasText; } /* taste-skill-ignore: forced-colors needs an edge */
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const done = document.querySelector<HTMLElement>('[data-done]');
  if (form && done) {
    type Labels = Record<'name' | 'phone' | 'business' | 'kind' | 'screens' | 'city' | 'email' | 'notes' | 'lang', string> & { options: Record<string, string> };
    const labels = JSON.parse(form.dataset['labels'] ?? '{}') as Labels;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const fail = form.querySelector<HTMLElement>('[data-fail]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = submit.querySelector<HTMLElement>('[data-label]')!;
    const idle = submitLabel.textContent ?? '';
    let tried = false;

    const showDone = (phone: string) => {
      form.hidden = true;
      done.hidden = false;
      done.querySelector<HTMLElement>('[data-done-phone]')!.textContent = phone;
      if (!phone) done.querySelector('p')?.setAttribute('hidden', '');
      done.focus();
    };
    const params = new URLSearchParams(location.search);
    if (params.has('sent')) showDone('');

    // a plan chosen on the pricing cards arrives as ?plan=
    const plan = params.get('plan');
    const planInput = plan ? form.querySelector<HTMLInputElement>(`input[name="screens"][value="${CSS.escape(plan)}"]`) : null;
    if (planInput) planInput.checked = true;

    // Saudi mobile: accepts Arabic-Indic digits, spaces, +966 / 00966 / 966 prefixes; returns 05xxxxxxxx or ''
    const phoneOf = (raw: string) => {
      const digits = raw.replace(/[٠-٩]/g, (d) => String(d.charCodeAt(0) - 0x660)).replace(/[۰-۹]/g, (d) => String(d.charCodeAt(0) - 0x6f0)).replace(/[^\d+]/g, '');
      const m = /^(?:\+?966|00966|0)?(5\d{8})$/.exec(digits);
      return m ? `0${m[1]}` : '';
    };
    const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | RadioNodeList | null)?.value.trim() ?? '';

    const checks: Record<string, () => boolean> = {
      name: () => value('name').length >= 2,
      phone: () => phoneOf(value('phone')) !== '',
      business: () => value('business').length >= 2,
      kind: () => value('kind') !== '',
      screens: () => value('screens') !== '',
      email: () => value('email') === '' || /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value('email')),
    };
    const mark = (name: string) => {
      const ok = checks[name]!();
      const err = form.querySelector<HTMLElement>(`#f-${name}-err`);
      if (err) err.hidden = ok;
      const input = form.querySelector<HTMLInputElement>(`#f-${name}`);
      if (input) input.setAttribute('aria-invalid', String(!ok));
      const set = form.querySelector<HTMLFieldSetElement>(`fieldset:has(input[name="${name}"])`);
      if (set) set.toggleAttribute('data-invalid', !ok);
      return ok;
    };
    form.addEventListener('input', (e) => {
      const name = (e.target as HTMLInputElement).name;
      if (tried && name in checks) { mark(name); if (Object.keys(checks).every((n) => checks[n]!())) status.textContent = ''; }
    });
    form.addEventListener('change', (e) => {
      const name = (e.target as HTMLInputElement).name;
      if (tried && name in checks) mark(name);
    });
    // tidy the number once the visitor leaves the field
    form.querySelector<HTMLInputElement>('[data-phone]')?.addEventListener('blur', (e) => {
      const input = e.target as HTMLInputElement;
      const clean = phoneOf(input.value);
      if (clean) input.value = clean;
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submit.getAttribute('aria-busy') === 'true') return;
      tried = true;
      const bad = Object.keys(checks).filter((n) => !mark(n));
      if (bad.length) {
        status.textContent = form.dataset['fix'] ?? '';
        const first = form.querySelector<HTMLElement>(`#f-${bad[0]}, input[name="${bad[0]}"]`);
        first?.focus();
        return;
      }
      status.textContent = '';
      fail.hidden = true;
      submit.setAttribute('aria-busy', 'true');
      submitLabel.textContent = form.dataset['sending'] ?? idle;

      const phone = phoneOf(value('phone'));
      const opt = (v: string) => labels.options[v] ?? v;
      const body: Record<string, string> = {
        _subject: `${form.dataset['subject']}: ${value('business')}`,
        _template: 'table',
        _captcha: 'false',
        _honey: value('_honey'),
        [labels.name]: value('name'),
        [labels.phone]: phone,
        [labels.business]: value('business'),
        [labels.kind]: opt(value('kind')),
        [labels.screens]: opt(value('screens')),
        [labels.city]: value('city') || '—',
        [labels.email]: value('email') || '—',
        [labels.notes]: value('notes') || '—',
        [labels.lang]: value('lang') === 'ar' ? 'العربية' : 'English',
      };
      try {
        const res = await fetch(form.dataset['endpoint']!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(body),
        });
        const data = (await res.json().catch(() => ({}))) as { success?: string | boolean };
        if (!res.ok || String(data.success) !== 'true') throw new Error('not sent');
        showDone(phone);
      } catch {
        fail.hidden = false;
      } finally {
        submit.removeAttribute('aria-busy');
        submitLabel.textContent = idle;
      }
    });
  }
</script>
