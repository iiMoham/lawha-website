---
// Pricing: four yearly packages side by side (owner's prices). No monthly billing and no screen calculator:
// each package names its screens. The free trial leads, Growth is the popular (dark) card, VIP carries every
// feature in the app. Each card's button opens the start form with that package chosen (?plan=).
import { startHref, type Content } from '../i18n';
import Signal from './Signal.astro';
interface Props { c: Content }
const { c } = Astro.props;
const p = c.pricing;
const popular = 'growth';
const check = '<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const money = (n: number) => n.toLocaleString('en-US');
---
<section class="pricing wrap" id="pricing" aria-labelledby="price-h">
  <header class="sec-head" data-reveal>
    <h2 class="sec-title" id="price-h">{p.heading}</h2>
    <p class="sec-sub">{p.sub}</p>
  </header>

  <div class="plans">
    {p.plans.map((plan, i) => (
      <article class:list={['plan', `plan-${plan.id}`, { 'is-popular': plan.id === popular }]} data-reveal style={`--i:${i}`} aria-labelledby={`plan-${plan.id}`}>
        <div class="tags">
          {plan.id === popular && <span class="tag tag-pop">{p.popular}</span>}
        </div>
        <h3 class="name" id={`plan-${plan.id}`}><Signal size={20} level={plan.level as 1 | 2 | 3} class="reach" /> <span>{plan.name}</span></h3>
        <p class="range-chip">{plan.range}</p>
        {plan.price === 0 ? (
          <><p class="price"><span class="amount amount-free">{p.free}</span></p><p class="per">{p.trialFor}</p></>
        ) : (
          <><p class="price"><span class="amount nums">{money(plan.price)}</span><span class="cur">{c.currency}</span></p><p class="per">{p.perYear}</p></>
        )}
        <a class="button p-cta" href={startHref(c, plan.id)}>{plan.price === 0 ? p.trialCta : `${p.cta} ${plan.name}`} <span class="arrow" aria-hidden="true">→</span></a>
        <ul class="feats">
          {plan.items.map((x) => <li><span class="tick" set:html={check} />{x}</li>)}
        </ul>
      </article>
    ))}
  </div>

  <ul class="assure" data-reveal>
    {p.assure.map((x) => <li><span class="tick" set:html={check} />{x}</li>)}
  </ul>
  <p class="hardware" data-reveal set:html={p.hardware} />
</section>

<style>
  .pricing { padding-block: 0 var(--section); }

  .plans { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(0.75rem, 1.2vw, 1.25rem); align-items: stretch; }
  .plan { --plan: #ffffff; --plan-ink: var(--ink); --plan-muted: var(--muted); --plan-line: #e3e6ec; position: relative; display: flex; flex-direction: column; padding: clamp(1.5rem, 2vw, 2rem); border-radius: calc(var(--radius) * 1.75); background: var(--plan); color: var(--plan-ink); outline: 1.5px solid var(--plan-line); outline-offset: -1.5px; transition: translate var(--t-ui) var(--ease-out); }
  /* the trial sits on the page's grey, so it reads as a way in rather than a fourth package */
  .plan-trial { --plan: var(--surface); --plan-line: var(--surface); }
  .plan.is-popular { --plan: var(--night); --plan-ink: var(--night-ink); --plan-muted: #a7afbf; --plan-line: var(--night); }
  @media (hover: hover) and (pointer: fine) { .plan:hover { translate: 0 -4px; } }

  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; min-block-size: 1.75rem; margin-block-end: 1rem; }
  .tag { display: inline-flex; align-items: center; padding: 0.2rem 0.65rem; border-radius: var(--pill); font-size: var(--step-small); font-weight: 500; line-height: 1.4; }
  .tag-pop { background: var(--accent); color: #fff; }

  .name { display: flex; align-items: center; gap: 0.45rem; font-size: clamp(1.375rem, 1.1rem + 0.8vw, 1.75rem); line-height: 1.3; font-weight: 700; }
  .name :global(.reach) { flex: none; color: var(--accent); --sig-faint: 0.2; }
  .range-chip { margin-block-start: 0.35rem; color: var(--plan-muted); font-weight: 500; }
  .price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.4rem; margin-block-start: 1.5rem; line-height: 1; }
  .amount { font-size: clamp(2.75rem, 1.8rem + 2vw, 4rem); font-weight: 700; letter-spacing: -0.02em; }
  .amount-free { color: var(--accent); }
  .cur { font-size: var(--step-lead); font-weight: 500; }
  .per { margin-block-start: 0.5rem; color: var(--plan-muted); font-size: var(--step-small); }
  .p-cta { justify-content: center; inline-size: 100%; margin-block-start: 1.5rem; min-block-size: 3.25rem; background: transparent; color: var(--plan-ink); outline: 1.5px solid currentColor; outline-offset: -1.5px; }
  .plan.is-popular .p-cta { background: var(--accent); color: #fff; outline: 0; }
  @media (hover: hover) and (pointer: fine) {
    .p-cta:hover { background: var(--ink); color: #fff; outline-color: var(--ink); }
    .plan.is-popular .p-cta:hover { background: var(--accent-strong); }
  }
  .feats { margin-block-start: 1.75rem; display: flex; flex-direction: column; gap: 0.6rem; font-size: var(--step-body); }
  .feats li:first-child { font-weight: 700; }
  .feats li, .assure li { display: flex; align-items: flex-start; gap: 0.6rem; }
  .tick { display: inline-grid; place-items: center; flex: none; inline-size: 1.375rem; block-size: 1.375rem; margin-block-start: 0.15em; border-radius: 50%; background: var(--accent-soft); color: var(--accent); }
  .plan-trial .tick { background: #fff; }
  .plan.is-popular .tick { background: var(--accent); color: #fff; }

  .assure { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-block-start: clamp(1.5rem, 3vw, 2.5rem); font-weight: 500; }
  .hardware { margin-block-start: 1rem; max-width: 70ch; color: var(--muted); font-size: var(--step-small); }

  @media (max-width: 72rem) {
    .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .assure { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 40rem) {
    .plans { grid-template-columns: minmax(0, 1fr); }
    .assure { grid-template-columns: minmax(0, 1fr); }
    .tags:empty { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .plan { transition: none; } }
</style>
