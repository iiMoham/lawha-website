---
// The owner app, cropped to the one screen the hero needs: pick a playlist, publish, see it live.
import { getImage } from 'astro:assets';
import type { Content } from '../i18n';
import Logo from './Logo.astro';
import Signal from './Signal.astro';
import shakshuka from '../assets/media/shakshuka.jpg';
import burger from '../assets/media/burger-meal.jpg';
import cake from '../assets/media/coffee-cake.jpg';

interface Props { c: Content }
const { c } = Astro.props;
const p = c.phone;
const pics = { shakshuka, burger, cake } as const;
const thumbs: Record<string, string> = Object.fromEntries(await Promise.all(c.playlists.map(async (pl) =>
  [pl.id, (await getImage({ src: pics[pl.offer.key], width: 112, height: 112, fit: 'cover', format: 'webp' })).src])));
const first = c.playlists[0]?.id ?? '';
---
<div class="phone" data-ui data-phone>
  <div class="ph">
    <div class="ph-head">
      <Logo size={30} />
      <div class="ph-who">
        <span class="ph-cafe">{p.cafe}</span>
        <span class="ph-branch">{p.branch}</span>
      </div>
    </div>
    <p class="ph-state" data-state data-on={p.screens} data-off={p.screensOffline}><Signal size={13} /><span data-state-text>{p.screens}</span></p>

    <fieldset class="ph-list">
      <legend class="ph-q">{p.choose}</legend>
      {c.playlists.map((pl) => (
        <label class="ph-item">
          <img class="ph-thumb" src={thumbs[pl.id]} alt="" width="56" height="56" />
          <span class="ph-txt"><span class="ph-name">{pl.label}</span><span class="ph-meta">{pl.meta}</span></span>
          <input class="ph-radio" type="radio" name="hero-playlist" value={pl.id} checked={pl.id === first} data-pick={pl.id} />
        </label>
      ))}
    </fieldset>

    <button type="button" class="ph-publish" data-publish>{p.publish}</button>
    <p class="ph-status" aria-live="polite" data-status data-live={p.live} data-sending={p.sending} data-queued={p.queued}>
      <Signal size={13} /><span data-status-text>{p.live}</span>
    </p>

    <label class="ph-net">
      <span class="ph-net-l">{p.internet}</span>
      <span class="ph-net-v" data-net-label data-on={p.internetOn} data-off={p.internetOff}>{p.internetOn}</span>
      <input class="switch" type="checkbox" role="switch" checked data-net />
    </label>
  </div>
</div>

<style>
  .phone { --ph-bg: #ffffff; --ph-line: #e3e6ec; inline-size: 100%; max-inline-size: 23rem; background: var(--night); padding: 0.5625rem; border-radius: 2.5rem; font-size: 0.9375rem; line-height: 1.4; }
  .ph { background: var(--ph-bg); border-radius: 2rem; padding: 1.375rem 1.125rem 1.125rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .ph-head { display: flex; align-items: center; gap: 0.625rem; }
  .ph-who { display: flex; flex-direction: column; }
  .ph-cafe { font-weight: 700; font-size: 1rem; }
  .ph-branch { font-size: 0.8125rem; color: var(--muted); }
  .ph-state, .ph-status { display: flex; align-items: center; gap: 0.5rem; font-size: 0.84375rem; color: var(--muted); max-width: none; }
  /* the logo's arcs as the app's own status mark: green and full when live, faint outer arcs when offline */
  .ph-state :global(.signal), .ph-status :global(.signal) { color: var(--live); transition: color var(--t-ui) ease; }
  .ph-state[data-offline] :global(.signal) { color: var(--warn); }
  .ph-state[data-offline] :global(.signal :is(.a2, .a3)) { opacity: var(--sig-faint); }
  .ph-list { display: flex; flex-direction: column; gap: 0.5rem; margin: 0.25rem 0 0; padding: 0; border: 0; min-inline-size: 0; }
  .ph-q { padding: 0; margin-block-end: 0.25rem; font-weight: 700; font-size: 0.9375rem; }
  .ph-item { display: flex; align-items: center; gap: 0.75rem; inline-size: 100%; padding: 0.5rem; border-radius: 1rem; background: #fff; outline: 1.5px solid var(--ph-line); outline-offset: -1.5px; cursor: pointer; transition: outline-color var(--t-ui) ease, background-color var(--t-ui) ease, scale var(--t-press) var(--ease-out); }
  .ph-item:active { scale: 0.98; }
  .ph-item:has(:checked) { background: var(--accent-soft); outline: 2px solid var(--accent); outline-offset: -2px; }
  .ph-item:has(:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
  .ph-thumb { inline-size: 3.25rem; block-size: 3.25rem; border-radius: 0.6875rem; object-fit: cover; flex: none; background: var(--surface); }
  .ph-txt { display: flex; flex-direction: column; min-inline-size: 0; flex: 1; }
  .ph-name { font-weight: 500; font-size: 0.9375rem; }
  .ph-meta { font-size: 0.8125rem; color: var(--muted); }
  .ph-radio { appearance: none; flex: none; inline-size: 1.25rem; block-size: 1.25rem; margin: 0; border-radius: 50%; border: 2px solid #a3aab8; cursor: pointer; transition: border-width var(--t-ui) ease, border-color var(--t-ui) ease; }
  .ph-radio:checked { border: 0.375rem solid var(--accent); }
  .ph-radio:focus-visible { outline: none; }
  @media (forced-colors: active) { .ph-radio:checked { background: CanvasText; } }
  .ph-publish { min-block-size: 3.125rem; border-radius: 999px; background: var(--accent); color: var(--accent-ink); font-weight: 500; font-size: 1rem; transition: scale var(--t-press) var(--ease-out), background-color var(--t-hover) ease; }
  .ph-publish:active, .ph-publish.is-pressed { scale: 0.97; background: var(--accent-strong); }
  .ph-status { justify-content: center; min-block-size: 1.25rem; }
  /* publishing: the arcs go out one after another; waiting for the internet: only the inner arc */
  .ph-status[data-mode="sending"] :global(.signal) { color: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    .ph-status[data-mode="sending"] :global(.signal .a) { animation: sig-send 0.9s var(--ease-in-out) infinite both; }
    .ph-status[data-mode="sending"] :global(.signal .a2) { animation-delay: 0.14s; }
    .ph-status[data-mode="sending"] :global(.signal .a3) { animation-delay: 0.28s; }
  }
  .ph-status[data-mode="queued"] :global(.signal) { color: var(--warn); }
  .ph-status[data-mode="queued"] :global(.signal :is(.a2, .a3)) { opacity: var(--sig-faint); }
  .ph-net { display: flex; align-items: center; gap: 0.625rem; min-block-size: 2.75rem; padding: 0.5rem 0.25rem 0; font-size: 0.875rem; cursor: pointer; border-block-start: 1.5px solid var(--ph-line); }
  .ph-net-l { flex: 1; font-weight: 500; }
  .ph-net-v { color: var(--muted); font-size: 0.8125rem; }
  .ph-net .switch { font-size: 0.875rem; }
  @media (hover: hover) and (pointer: fine) {
    .ph-item:not(:has(:checked)):hover { outline-color: #a9bcff; }
    .ph-publish:hover { background: var(--accent-strong); }
  }
  .ph-item.is-auto { outline: 2px solid var(--accent); outline-offset: -2px; }
</style>
