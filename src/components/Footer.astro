---
// Contact as the headline. All contact details are PLACEHOLDERS.
import Logo from './Logo.astro';
import Signal from './Signal.astro';
import credits from '../assets/media/credits.json';
import type { Content } from '../i18n';
interface Props { c: Content }
const { c } = Astro.props;
const f = c.footer;
type Credit = { file: string; title: string; creator?: string; license?: string; licenseUrl?: string; page: string; via?: string };
// credits.json keeps every sourced file; only credit what the page shows (the hero's offer photos, also used in How it works).
const onPage = ['shakshuka.jpg', 'burger-meal.jpg', 'coffee-cake.jpg'];
const list = (credits as Credit[]).filter((x) => onPage.some((f) => x.file.endsWith(f))).map((x) => ({ ...x, title: x.title.length > 70 ? `${x.title.slice(0, 68).trim()}…` : x.title }));
---
<footer class="footer">
  <div class="wrap f-in">
    <div class="f-top">
      <div class="notes">
        <span class="f-brand"><Logo size={28} inverse /> {c.nav.brand}</span>
        <p class="about">{f.about}</p>
        <p class="place">{f.address}<br />{f.hours}</p>
        <p class="call"><a class="link" href={`tel:${f.phone.replaceAll(' ', '')}`} dir="ltr">{f.phone}</a><br />{f.cr}</p>
      </div>
      <a class="link top" href="#top">{f.top} <Signal size={14} class="up" /></a>
    </div>

    <a class="mail" href={`mailto:${f.email}`} dir="ltr"><span>{f.emailUser}</span><wbr /><span class="at">{f.emailDomain}</span></a>

    <div class="meta">
      <nav class="f-links" aria-label={c.nav.brand}>
        {f.links.map((l) => <a class="link" href={l.href}>{l.label}</a>)}
      </nav>
      <details class="credits">
        <summary>{f.credits}</summary>
        <ul>
          {list.map((x) => (
            <li lang="en" dir="ltr"><a class="link" href={x.page}>{x.title}</a>{x.creator ? `, ${x.creator}` : ''}{x.licenseUrl ? <>, <a class="link" href={x.licenseUrl}>{x.license ?? 'Licence'}</a></> : null}{x.via ? `, via ${x.via}` : ''}</li>
          ))}
        </ul>
      </details>
      <span class="city">{f.city}</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--accent); color: var(--accent-ink); }
  .f-in { display: flex; flex-direction: column; gap: clamp(3rem, 7vw, 6rem); padding-block: clamp(2.5rem, 5vw, 4rem) 2rem; }
  .f-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; }
  .notes { display: grid; grid-template-columns: repeat(4, auto); gap: 0.5rem 3rem; font-size: var(--step-small); line-height: 1.7; align-items: start; }
  .notes p { max-width: 26ch; }
  .f-brand { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-display); font-weight: 700; font-size: var(--step-lead); line-height: 1.2; }
  .top { white-space: nowrap; font-size: var(--step-small); text-decoration-color: currentColor; }
  /* the arcs already point up: the logo is the arrow */
  .top :global(.up) { margin-inline-start: 0.35em; transition: translate var(--t-ui) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .top:hover :global(.up) { translate: 0 -3px; } }
  .mail { display: block; font-family: var(--font-display); font-weight: 700; font-size: clamp(2.5rem, 1rem + 5vw, 6rem); line-height: 1.05; letter-spacing: -0.03em; text-decoration: none; text-align: start; overflow-wrap: anywhere; transition: opacity var(--t-hover) ease; }
  :root[dir="rtl"] .mail { text-align: right; }
  @media (hover: hover) and (pointer: fine) { .mail:hover { opacity: 0.86; } }
  .meta { display: grid; grid-template-columns: 1fr auto 1fr; align-items: start; gap: 1.5rem; font-size: var(--step-small); }
  .f-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .f-links .link, .credits .link { text-decoration-color: rgb(255 255 255 / 0.55); }
  .credits summary { cursor: pointer; text-decoration: underline; text-underline-offset: 0.3em; text-decoration-color: rgb(255 255 255 / 0.55); list-style: none; }
  .credits summary::-webkit-details-marker { display: none; }
  .credits ul { margin-top: 0.75rem; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.35rem; max-width: 44rem; text-align: left; font-size: 0.875rem; line-height: 1.5; }
  .city { justify-self: end; }
  /* Phone: brand and "Back to top" share a row, the e-mail follows the
     line about Lawha, and hairlines split the details from the links. */
  @media (max-width: 54rem) {
    .f-in {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas: "brand top" "about about" "mail mail" "place place" "call call" "meta meta";
      gap: 0;
      padding-block: 2.5rem 1.5rem;
    }
    .f-top, .notes { display: contents; }
    .f-brand { grid-area: brand; align-self: center; }
    .top { grid-area: top; align-self: center; padding-block: 0.75rem; }
    .notes .about { grid-area: about; max-width: none; margin-top: 0.75rem; }
    .mail { grid-area: mail; margin-block: 2.25rem 2.5rem; font-size: clamp(2.5rem, 0.75rem + 9vw, 4.5rem); }
    .mail .at { display: block; }
    .notes .place { grid-area: place; max-width: none; padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / 0.3); }
    .notes .call { grid-area: call; max-width: none; margin-top: 0.75rem; }
    .meta {
      grid-area: meta;
      grid-template-columns: 1fr auto;
      gap: 0.5rem 1rem;
      margin-top: 1.5rem;
      padding-top: 0.75rem;
      border-top: 1px solid rgb(255 255 255 / 0.3);
    }
    .f-links { grid-column: 1 / -1; gap: 0 1.5rem; }
    /* 44px rows to tap, without looking any bigger */
    .f-links .link { display: inline-block; padding-block: 0.75rem; }
    .credits summary { padding-block: 0.75rem; }
    .credits { grid-column: 1; }
    .credits[open] { grid-column: 1 / -1; }
    .city { grid-column: 2; justify-self: end; padding-block: 0.75rem; }
  }
</style>
