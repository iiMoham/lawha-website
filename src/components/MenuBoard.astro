---
// Three TVs above a café counter, each holding one layer per playlist. The hero script switches layers.
import { Image } from 'astro:assets';
import type { Content } from '../i18n';
import Signal from './Signal.astro';
import shakshuka from '../assets/media/shakshuka.jpg';
import burger from '../assets/media/burger-meal.jpg';
import cake from '../assets/media/coffee-cake.jpg';

interface Props { c: Content }
const { c } = Astro.props;
const pics = { shakshuka, burger, cake } as const;
// where each photo's dish sits, so the crop keeps it in the photo half of the screen
const focus = { shakshuka: '50% 60%', burger: '30% 55%', cake: '100% 55%' } as const;
const first = c.playlists[0]?.id ?? '';
---
<span class="board" data-board data-ui data-active={first} aria-hidden="true">
  <span class="tv tv-a">
    <span class="screen">
      {c.playlists.map((p) => (
        <span class="layer list" data-pl={p.id} data-on={p.id === first ? '' : undefined}>
          <span class="t">{p.list.title}</span>
          {p.list.items.map((i) => (
            <span class="row"><span class="n">{i.name}</span><span class="p nums">{i.price}<small>{c.currency}</small></span></span>
          ))}
        </span>
      ))}
    </span>
    <span class="rx"><Signal size={12} /></span>
    <span class="led"></span>
  </span>

  <span class="tv tv-b">
    <span class="screen">
      {c.playlists.map((p) => (
        <span class="layer deal" data-pl={p.id} data-on={p.id === first ? '' : undefined}>
          <Image class="media" src={pics[p.offer.key]} alt="" widths={[400, 720, 1000]} sizes="(max-width: 54rem) 60vw, 26vw" quality={74}
            style={`object-position:${focus[p.offer.key]}`} {...(p.id === first ? { loading: 'eager', fetchpriority: 'high' } : { loading: 'lazy', fetchpriority: 'low' })} />
          <span class="panel">
            <span class="d-tag">{p.offer.tag}</span>
            <span class="d-title">{p.offer.title}</span>
            <span class="d-items">{p.offer.items.map((x, i) => <span class="d-item">{i > 0 && <b class="plus">+</b>}{x}</span>)}</span>
            <span class="d-price"><span class="now nums">{p.offer.price}<small>{c.currency}</small></span><s class="was nums">{p.offer.was}</s></span>
            <span class="d-note">{p.offer.note}</span>
          </span>
        </span>
      ))}
      <span class="offline-badge"><span class="dot"></span>{c.boardOffline}</span>
    </span>
    <span class="rx"><Signal size={12} /></span>
    <span class="led"></span>
  </span>

  <span class="tv tv-c">
    <span class="screen">
      {c.playlists.map((p) => (
        <span class={`layer ${p.side.offer ? 'offer' : 'list'}`} data-pl={p.id} data-on={p.id === first ? '' : undefined}>
          <span class="t">{p.side.title}</span>
          {p.side.items?.map((i) => (
            <span class="row"><span class="n">{i.name}</span><span class="p nums">{i.price}<small>{c.currency}</small></span></span>
          ))}
          {p.side.offer && <span class="big">{p.side.offer} <small>{c.currency}</small></span>}
          {p.side.offerNote && <span class="note">{p.side.offerNote}</span>}
        </span>
      ))}
    </span>
    <span class="rx"><Signal size={12} /></span>
    <span class="led"></span>
  </span>
</span>

<style>
  /* one large picture screen beside two menu screens, the way they hang above a counter */
  .board { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: clamp(0.5rem, 1vw, 0.875rem); inline-size: 100%; font-family: var(--font-text); font-size: 1rem; letter-spacing: 0; line-height: 1.2; font-weight: 400; }
  .tv-b { grid-column: 1; grid-row: 1 / span 2; }
  .tv-a { grid-column: 2; grid-row: 1; aspect-ratio: 16 / 9; }
  .tv-c { grid-column: 2; grid-row: 2; aspect-ratio: 16 / 9; }
  .tv { position: relative; display: block; min-width: 0; background: var(--tv); padding: 5px; border-radius: 10px; transition: transform 300ms var(--ease-out); }
  .tv.is-hit { transform: translateY(-3px); }
  .screen { position: relative; display: block; height: 100%; overflow: hidden; border-radius: 6px; background: var(--tv-screen); color: var(--tv-ink); container-type: size; }
  .led { position: absolute; bottom: 1px; inset-inline-start: 50%; width: 4px; height: 2px; border-radius: 2px; background: #ef4444; opacity: 0.8; }
  .tv.is-hit .led { background: var(--live); }
  /* received: the logo's arcs appear in the screen's corner and light up from the inner arc out, then go */
  .rx { position: absolute; z-index: 3; inset-block-start: 11px; inset-inline-end: 11px; display: grid; place-items: center; inline-size: 26px; block-size: 26px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); opacity: 0; scale: 0.6; transition: opacity 360ms ease, scale 420ms var(--ease-out); }
  .rx :global(.signal) { display: block; }
  .tv.is-rx .rx { opacity: 1; scale: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .tv.is-rx .rx :global(.a) { animation: sig-rx 420ms var(--ease-out) both; }
    .tv.is-rx .rx :global(.a2) { animation-delay: 120ms; }
    .tv.is-rx .rx :global(.a3) { animation-delay: 240ms; }
  }

  .layer { position: absolute; inset: 0; display: flex; flex-direction: column; opacity: 0; visibility: hidden; }
  .layer[data-on] { opacity: 1; visibility: visible; }
  @media (prefers-reduced-motion: no-preference) {
    .layer.is-entering { animation: wipe 620ms var(--ease-in-out) both; }
  }
  @keyframes wipe { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }

  .list { padding: 7cqh 8cqw; gap: 2.5cqh; justify-content: center; }
  .t { font-family: var(--font-display); font-weight: 700; color: var(--signal); font-size: max(0.8125rem, min(16cqh, 9cqw)); line-height: 1.15; margin-bottom: 2cqh; }
  :root[lang="en"] .t { letter-spacing: -0.01em; }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5em; font-size: max(0.6875rem, min(10.5cqh, 6cqw)); }
  .n { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .p { font-weight: 700; color: var(--tv-ink); white-space: nowrap; }
  .p small, .chip small, .big small { font-size: 0.72em; font-weight: 500; margin-inline-start: 0.2em; color: var(--tv-muted); }

  /* the big screen: a combo offer as real menu boards sell it. Photo on one side, a solid panel with
     what's in the combo, the price and the old price on the other. Sizes follow the screen (container units). */
  .deal { flex-direction: row; }
  .deal .media { position: absolute; inset-block: 0; inset-inline-end: 0; inline-size: 56%; block-size: 100%; object-fit: cover; background: #111522; }
  .panel { position: relative; display: flex; flex-direction: column; justify-content: center; gap: 3.2cqh; inline-size: 44%; block-size: 100%; padding: 6cqh 4.5cqw; background: var(--tv-screen); }
  .d-tag { align-self: flex-start; padding: 0.2em 0.65em; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font-weight: 700; font-size: max(0.625rem, min(5.2cqh, 2.6cqw)); }
  .d-title { font-family: var(--font-display); font-weight: 700; color: var(--tv-ink); font-size: max(0.9375rem, min(11cqh, 5.4cqw)); line-height: 1.15; }
  :root[lang="en"] .d-title { letter-spacing: -0.01em; }
  .d-items { display: flex; flex-direction: column; gap: 0.9cqh; color: #c9d3ea; font-size: max(0.625rem, min(5.4cqh, 2.7cqw)); }
  .d-item { display: flex; align-items: baseline; gap: 0.4em; }
  .plus { color: var(--signal); font-weight: 700; }
  .d-price { display: flex; align-items: baseline; gap: 0.5em; margin-block-start: 1cqh; }
  .now { padding: 0.1em 0.5em; border-radius: 999px; background: var(--accent); color: var(--accent-ink); font-weight: 700; font-size: max(0.9375rem, min(11cqh, 5.6cqw)); line-height: 1.25; }
  .now small { font-size: 0.5em; font-weight: 500; margin-inline-start: 0.25em; color: rgb(255 255 255 / 0.85); }
  .was { color: var(--tv-muted); font-size: max(0.6875rem, min(6cqh, 3cqw)); text-decoration-thickness: 0.08em; }
  .d-note { color: var(--tv-muted); font-size: max(0.5625rem, min(4.4cqh, 2.2cqw)); }

  .offer { padding: 9cqh 8cqw; justify-content: center; gap: 4cqh; background: #121a33; }
  .offer .t { color: var(--tv-ink); margin: 0; }
  .big { font-family: var(--font-display); font-weight: 700; font-size: max(0.875rem, min(20cqh, 11cqw)); line-height: 1.15; color: var(--signal); }
  .big small { color: var(--tv-ink); }
  .note { font-size: max(0.6875rem, min(9.5cqh, 5.4cqw)); color: #c9d3ea; }

  .offline-badge { position: absolute; top: 5cqh; inset-inline-end: 4cqw; display: inline-flex; align-items: center; gap: 0.4em; padding: 0.25em 0.6em; border-radius: 999px; background: rgb(255 255 255 / 0.94); color: var(--ink); font-size: max(0.625rem, min(8.5cqh, 4.6cqw)); font-weight: 500; opacity: 0; transform: translateY(-6px); transition: opacity 300ms ease, transform 300ms var(--ease-out); }
  .offline-badge .dot { width: 0.55em; height: 0.55em; border-radius: 50%; background: var(--warn); }
  .board.is-offline .offline-badge { opacity: 1; transform: none; }

  @media (max-width: 54rem) {
    .board { grid-template-columns: minmax(0, 1fr); }
    .tv-a, .tv-c { display: none; }
    .tv-b { grid-row: auto; aspect-ratio: 16 / 9; }
  }
</style>
