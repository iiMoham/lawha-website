---
// Large questions with their answers beside them. Every answer is open.
import type { Content } from '../i18n';
interface Props { c: Content }
const { c } = Astro.props;
const f = c.faq;
---
<section class="faq wrap" id="faq" aria-labelledby="faq-h">
  <header class="sec-head" data-reveal>
    <h2 class="sec-title" id="faq-h">{f.heading}</h2>
  </header>
  <dl class="list">
    {f.items.map((it, i) => (
      <div class="row" data-reveal style={`--i:${i % 2}`}>
        <dt class="q">{it.q}</dt>
        <dd class="a" set:html={it.a} />
      </div>
    ))}
  </dl>
</section>

<style>
  .faq { padding-block: 0 var(--section); }
  .list { display: flex; flex-direction: column; gap: clamp(2rem, 3.5vw, 3rem); margin-top: 0; }
  .row { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: baseline; }
  .q { grid-column: 1 / span 5; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.25rem, 1rem + 0.8vw, 1.75rem); line-height: var(--lh-head); text-wrap: balance; }
  .a { grid-column: 6 / -1; font-size: var(--step-body); max-width: 58ch; }
  @media (max-width: 54rem) {
    /* stretch, not the desktop baseline: in a column, baseline pushed the questions to the left in Arabic */
    .row { display: flex; flex-direction: column; align-items: stretch; gap: 0.75rem; }
    .q { font-size: 1.25rem; }
    .list { gap: 2.25rem; }
  }
</style>
