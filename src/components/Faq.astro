---
// Questions as a chat with Lawha. The visitor taps a question: it goes out as their message, Lawha types, and the
// answer comes back as a reply. The first exchange is already there; asked questions dim in the list.
// Without script every question and answer is in the thread, in order (the <template> holds them for the script).
import type { Content } from '../i18n';
import Logo from './Logo.astro';
interface Props { c: Content }
const { c } = Astro.props;
const f = c.faq;
const ar = c.lang === 'ar';
const t = ar
  ? { name: 'فريق لوحة', status: 'متصل الحين', ask: 'اسأل', typing: 'يكتب…', thread: 'المحادثة' }
  : { name: 'Lawha team', status: 'Online now', ask: 'Ask', typing: 'typing…', thread: 'Conversation' };
---
<section class="faq wrap" id="faq" aria-labelledby="faq-h" data-faq>
  <header class="sec-head" data-reveal>
    <h2 class="sec-title" id="faq-h">{f.heading}</h2>
  </header>

  <div class="room" data-reveal style="--i:1">
    <div class="chat">
      <div class="bar">
        <Logo size={36} />
        <span class="who"><b>{t.name}</b><span class="on"><i></i>{t.status}</span></span>
      </div>
      <div class="thread" role="log" aria-live="polite" aria-label={t.thread} data-thread>
        {f.items.map((it, i) => (
          <div class="pair" data-qa={i}>
            <p class="msg me">{it.q}</p>
            <p class="msg them" set:html={it.a} />
          </div>
        ))}
      </div>
    </div>

    <div class="asks" data-asks hidden>
      <span class="ask-l">{t.ask}</span>
      <div class="chips">
        {f.items.map((it, i) => (
          <button type="button" class="chip" data-ask={i}>{it.q}</button>
        ))}
      </div>
    </div>
  </div>
  <template data-typing><p class="msg them typing" aria-label={t.typing}><span></span><span></span><span></span></p></template>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-faq]');
  if (root) {
    const thread = root.querySelector<HTMLElement>('[data-thread]')!;
    const asks = root.querySelector<HTMLElement>('[data-asks]')!;
    const typing = root.querySelector<HTMLTemplateElement>('[data-typing]')!;
    const pairs = [...thread.querySelectorAll<HTMLElement>('[data-qa]')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let busy = false;

    // start with the first exchange; the rest wait to be asked
    pairs.forEach((p, i) => { if (i > 0) p.hidden = true; });
    const chips = asks.querySelector<HTMLElement>('.chips')!;
    // an asked question moves to the end of the list, so the next unasked one is always first in view
    const markAsked = (chip: HTMLElement) => { chip.setAttribute('data-asked', ''); chips.append(chip); };
    const first = root.querySelector<HTMLElement>('[data-ask="0"]');
    if (first) markAsked(first);
    asks.hidden = false;

    const toBottom = () => thread.scrollTo({ top: thread.scrollHeight, behavior: still ? 'auto' : 'smooth' });

    asks.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-ask]');
      if (!chip || busy) return;
      const pair = pairs[Number(chip.dataset['ask'])];
      if (!pair) return;
      markAsked(chip);
      chips.scrollTo({ left: 0 });
      // asked before: bring it to the bottom again
      thread.append(pair);
      const [q, a] = [pair.children[0] as HTMLElement, pair.children[1] as HTMLElement];
      pair.hidden = false;
      if (still) { toBottom(); return; }
      busy = true;
      a.hidden = true;
      q.classList.add('pop');
      const dots = typing.content.firstElementChild!.cloneNode(true) as HTMLElement;
      window.setTimeout(() => { pair.append(dots); toBottom(); }, 260);
      window.setTimeout(() => {
        dots.remove();
        a.hidden = false;
        a.classList.add('pop');
        toBottom();
        busy = false;
      }, 1050);
      toBottom();
    });
  }
</script>

<style>
  .faq { padding-block: 0 var(--section); }
  .room { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 1.25rem; align-items: start; }

  /* the chat */
  .chat { grid-column: 1 / span 7; display: flex; flex-direction: column; border-radius: calc(var(--radius) * 2); background: #fff; overflow: hidden; outline: 1.5px solid var(--surface); outline-offset: -1.5px; }
  .bar { display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; border-block-end: 1.5px solid var(--surface); }
  .who { display: grid; gap: 0.1rem; line-height: 1.3; }
  .on { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--muted); font-size: var(--step-small); }
  .on i { inline-size: 0.5rem; block-size: 0.5rem; border-radius: 50%; background: var(--live); }
  .thread {
    display: flex; flex-direction: column; gap: 0.6rem; block-size: clamp(22rem, 40vw, 28rem); overflow-y: auto; overscroll-behavior: contain;
    padding: 1.25rem; background: var(--bg);
  }
  .pair { display: flex; flex-direction: column; gap: 0.6rem; }
  .pair[hidden] { display: none; }
  .msg { max-inline-size: min(80%, 30rem); padding: 0.7rem 1rem; border-radius: 1.1rem; font-size: var(--step-body); line-height: 1.55; }
  .msg[hidden] { display: none; }
  .me { align-self: flex-end; background: var(--accent); color: var(--accent-ink); border-end-end-radius: 0.35rem; font-weight: 500; }
  .them { align-self: flex-start; background: #fff; color: var(--ink); border-end-start-radius: 0.35rem; outline: 1.5px solid var(--surface); outline-offset: -1.5px; }
  .pop { animation: pop 360ms var(--ease-out) both; }
  @keyframes pop { from { opacity: 0; translate: 0 10px; scale: 0.96; } }

  .typing { display: inline-flex; gap: 0.3rem; padding: 0.9rem 1rem; }
  .typing span { inline-size: 0.45rem; block-size: 0.45rem; border-radius: 50%; background: var(--muted); animation: dot 900ms ease-in-out infinite; }
  .typing span:nth-child(2) { animation-delay: 150ms; }
  .typing span:nth-child(3) { animation-delay: 300ms; }
  @keyframes dot { 0%, 60%, 100% { opacity: 0.3; translate: 0 0; } 30% { opacity: 1; translate: 0 -3px; } }

  /* the questions to ask */
  .asks { grid-column: 8 / -1; display: grid; gap: 0.75rem; }
  .asks[hidden] { display: none; }
  .ask-l { color: var(--muted); font-size: var(--step-small); font-weight: 500; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    min-block-size: 2.75rem; padding: 0.55rem 1rem; border: 1.5px solid var(--field, #d5dae3); border-radius: var(--pill); background: #fff;
    color: var(--ink); font: inherit; font-size: var(--step-small); font-weight: 500; text-align: start; cursor: pointer;
    transition: background-color var(--t-hover) ease, border-color var(--t-hover) ease, color var(--t-hover) ease, scale var(--t-press) var(--ease-out);
  }
  .chip:active { scale: 0.96; }
  .chip[data-asked] { border-color: transparent; background: var(--surface); color: var(--muted); }
  @media (hover: hover) and (pointer: fine) { .chip:hover { border-color: var(--accent); color: var(--accent); } }

  @media (max-width: 54rem) {
    .chat, .asks { grid-column: 1 / -1; }
    .thread { block-size: 24rem; }
    /* on a phone the questions sit under the chat like suggested replies, in one scrolling row */
    .chips { flex-wrap: nowrap; overflow-x: auto; scroll-snap-type: x proximity; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scrollbar-width: none; }
    .chips::-webkit-scrollbar { display: none; }
    .chip { flex: none; scroll-snap-align: start; white-space: nowrap; }
  }
  @media (prefers-reduced-motion: reduce) { .pop, .typing span { animation: none; } }
</style>
